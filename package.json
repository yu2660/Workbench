{
  "name": "workbench-courses",
  "version": "0.1.1",
  "description": "离线课程资料管理与阅读",
  "author": "Workbench",
  "license": "MIT",
  "overrides": { "global-agent": "4.1.3" },
  "main": "src/main.cjs",
  "scripts": {
    "start": "electron .",
    "test": "node --test tests/core.test.cjs",
    "test:e2e": "node tests/e2e.cjs",
    "test:navigation": "node tests/reader-navigation.cjs",
    "dist": "electron-builder --win nsis --x64",
    "licenses": "node scripts/licenses.cjs"
  },
  "dependencies": {
    "pdf-lib": "1.17.1",
    "pdfjs-dist": "6.4.299"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "electron": "44.7.2",
    "electron-builder": "26.15.3"
  },
  "build": {
    "appId": "local.workbench.courses",
    "productName": "Workbench",
    "npmRebuild": false,
    "electronDist": "node_modules/electron/dist",
    "directories": {
      "output": "dist"
    },
    "files": [
      "src/**/*",
      "renderer/**/*",
      "assets/**/*",
      "scripts/powerpoint.ps1",
      "THIRD_PARTY_NOTICES.md",
      "licenses/**/*",
      "package.json",
      "LICENSE",
      "!node_modules/@napi-rs/**/*",
      "!node_modules/pdfjs-dist/legacy/**/*"
    ],
    "asarUnpack": [
      "scripts/powerpoint.ps1"
    ],
    "extraFiles": [
      { "from": "THIRD_PARTY_NOTICES.md", "to": "THIRD_PARTY_NOTICES.md" },
      { "from": "licenses", "to": "licenses" },
      { "from": "LICENSE", "to": "LICENSE.Workbench.txt" }
    ],
    "win": {
      "target": "nsis",
      "icon": "assets/workbench.ico",
      "signExecutable": false
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "deleteAppDataOnUninstall": false
    }
  }
}
